MHG.SettingsMenu.Pages.Controls.Headings.Eves_QoL: "Mod: Eve's QoL"

FancyInput.Trigger.Eves_QoL.RestoreSelection: "Restore last selection"
FancyInput.Trigger.Eves_QoL.RestoreSelection.Description: """
    Re-selects the last group of components you moved, cloned, rotated, or flipped.
    Press while building to jump back into multi-selection with those components.
    Does not remember deleted components.
    """

FancyInput.Trigger.Eves_QoL.SelectLine: "Select components in line"
FancyInput.Trigger.Eves_QoL.SelectLine.Description: """
    Selects a line of same-type components.
    Press while looking at the first component, then press again while looking at the last component.
    Automatically expands past both anchors to grab the full run of evenly-spaced components.
    """